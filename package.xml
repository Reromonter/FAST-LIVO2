<?xml version="1.0"?>
<package format="3">
  <name>fast_livo</name>
  <version>2.0.0</version>

  <description>
    FAST-LIVO2: Fast, Direct LiDAR-Inertial-Visual Odometry (ROS2 port).
  </description>

  <maintainer email="zhengcr@connect.hku.hk">Chunran Zheng</maintainer>

  <license>GPLv2</license>

  <author email="zhengcr@connect.hku.hk">Chunran Zheng</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>
  <depend>livox_ros_driver</depend>
  <depend>vikit_common</depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>boost</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
